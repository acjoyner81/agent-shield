# Runtime
APP_ENV=development
APP_NAME=agent-shield
LOG_LEVEL=INFO

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
REQUEST_TIMEOUT_SECONDS=60
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_DAILY_BUDGET_USD=10.00

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Database
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield@localhost:5432/agentshield

# Authentication / tenant security
AUTH0_DOMAIN=dev-zymaiayb0afkpn7n.us.auth0.com
AUTH0_ISSUER=https://dev-zymaiayb0afkpn7n.us.auth0.com/
AUTH0_AUDIENCE=https://api.agentshield.local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_AUDIENCE=https://api.agentshield.local
API_KEY_HASH_SALT=

# LLM provider credentials: set locally, never commit real values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_MASTER_KEY=

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-shield-local

# MCP
MCP_SERVER_TRANSPORT=stdio
MCP_SERVER_COMMAND=python
MCP_SERVER_SCRIPT=mcp_servers/tools_server.py

# Evaluation
EVAL_ENABLED=false
EVAL_JUDGE_MODEL=
EVAL_SCORE_THRESHOLD=0.85

# Splunk
# Both of these are mandatory: compose refuses to start the collector without
# them. There is deliberately no SPLUNK_ENABLED switch. It used to sit here set
# to false and was read by zero lines of code, so it read as though telemetry
# shipping was switched off while shipping was in fact on and failing.
SPLUNK_PASSWORD=
SPLUNK_HEC_TOKEN=
# The scheme is load bearing: the collector only answers on TLS, so an http://
# URL here resets on every attempt and nothing is ever shipped. Left unset, the
# aggregator uses https://splunk:8088/services/collector/event.
SPLUNK_HEC_URL=
# Optional. Defaults to the admin password above; set it only if you want the
# collector's private key passphrase to differ from the admin credential.
SPLUNK_HEC_CERT_PASSWORD=

# Dynatrace / OpenTelemetry
DYNATRACE_ENABLED=false
OTEL_SERVICE_NAME=agent-shield
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Billing
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Tripwire FIM
TRIPWIRE_SITE_KEY=
TRIPWIRE_LOCAL_KEY=
