# Runtime
APP_ENV=development
APP_NAME=agent-shield
LOG_LEVEL=INFO

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
REQUEST_TIMEOUT_SECONDS=60
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_DAILY_BUDGET_USD=10.00

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Database
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield@localhost:5432/agentshield

# Authentication / tenant security
AUTH0_DOMAIN=dev-zymaiayb0afkpn7n.us.auth0.com
AUTH0_ISSUER=https://dev-zymaiayb0afkpn7n.us.auth0.com/
AUTH0_AUDIENCE=https://api.agentshield.local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_AUDIENCE=https://api.agentshield.local
API_KEY_HASH_SALT=

# LLM provider credentials: set locally, never commit real values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_MASTER_KEY=

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-shield-local

# MCP
MCP_SERVER_TRANSPORT=stdio
MCP_SERVER_COMMAND=python
MCP_SERVER_SCRIPT=mcp_servers/tools_server.py

# Evaluation
EVAL_ENABLED=false
EVAL_JUDGE_MODEL=
EVAL_SCORE_THRESHOLD=0.85

# Splunk
SPLUNK_ENABLED=false
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=agentshield
SPLUNK_SOURCE=agent-shield
SPLUNK_SOURCETYPE=_json
SPLUNK_PASSWORD=

# Dynatrace / OpenTelemetry
DYNATRACE_ENABLED=false
OTEL_SERVICE_NAME=agent-shield
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Billing
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Tripwire FIM
TRIPWIRE_SITE_KEY=
TRIPWIRE_LOCAL_KEY=
